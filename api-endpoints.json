{
  "project": "Gym Management API",
  "baseUrl": "http://localhost:3000",
  "version": "1.0.0",
  "authentication": "Bearer JWT Token (Authorization: Bearer <token>)",
  "modules": [
    {
      "module": "Auth",
      "basePath": "/auth",
      "endpoints": [
        {
          "id": "auth-login",
          "method": "POST",
          "path": "/auth/login",
          "description": "Login ເຂົ້າສູ່ລະບົບ — ຄືນ JWT Token",
          "auth": false,
          "roles": [],
          "body": {
            "phone": "string (required) — ເບີໂທ / Username",
            "password": "string (required) — ລະຫັດຜ່ານ"
          },
          "response": {
            "access_token": "string — JWT Token",
            "user": {
              "id": "number",
              "name": "string",
              "phone": "string",
              "role": "ADMIN | STAFF"
            }
          }
        },
        {
          "id": "auth-me",
          "method": "GET",
          "path": "/auth/me",
          "description": "ດຶງຂໍ້ມູນ Profile ຂອງ Token ປັດຈຸບັນ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "body": null,
          "response": {
            "id": "number",
            "name": "string",
            "phone": "string",
            "role": "ADMIN | STAFF"
          }
        }
      ]
    },
    {
      "module": "Users (Staff Management)",
      "basePath": "/users",
      "endpoints": [
        {
          "id": "users-create",
          "method": "POST",
          "path": "/users",
          "description": "ສ້າງ Staff / Admin ໃໝ່",
          "auth": true,
          "roles": ["ADMIN"],
          "body": {
            "name": "string (required)",
            "phone": "string (required) — ໃຊ້ເປັນ Username",
            "password": "string (required)",
            "role": "ADMIN | STAFF (optional, default: STAFF)"
          },
          "response": { "id": "number", "name": "string", "phone": "string", "role": "string" }
        },
        {
          "id": "users-findAll",
          "method": "GET",
          "path": "/users",
          "description": "ດຶງລາຍຊື່ Staff ທັງໝົດ",
          "auth": true,
          "roles": ["ADMIN"],
          "body": null,
          "response": "array of { id, name, phone, role }"
        },
        {
          "id": "users-findOne",
          "method": "GET",
          "path": "/users/:id",
          "description": "ດຶງຂໍ້ມູນ Staff ຕາມ ID",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "params": { "id": "number" },
          "body": null,
          "response": { "id": "number", "name": "string", "phone": "string", "role": "string" }
        },
        {
          "id": "users-update",
          "method": "PATCH",
          "path": "/users/:id",
          "description": "ແກ້ໄຂຂໍ້ມູນ Staff",
          "auth": true,
          "roles": ["ADMIN"],
          "params": { "id": "number" },
          "body": {
            "name": "string (optional)",
            "phone": "string (optional)",
            "password": "string (optional)",
            "role": "ADMIN | STAFF (optional)"
          },
          "response": { "id": "number", "name": "string", "phone": "string", "role": "string" }
        },
        {
          "id": "users-remove",
          "method": "DELETE",
          "path": "/users/:id",
          "description": "ລົບ Staff ອອກຈາກລະບົບ",
          "auth": true,
          "roles": ["ADMIN"],
          "params": { "id": "number" },
          "body": null,
          "response": { "id": "number", "name": "string" }
        }
      ]
    },
    {
      "module": "Members",
      "basePath": "/members",
      "endpoints": [
        {
          "id": "members-checkIn",
          "method": "POST",
          "path": "/members/check-in",
          "description": "Scan QR/Barcode Check-in — Anti-Passback 15 ນາທີ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "body": { "code": "string (required) — ລະຫັດບັດສະມາຊິກ" },
          "response": {
            "message": "string",
            "status": "SUCCESS",
            "member": {
              "id": "number",
              "fullName": "string",
              "code": "string",
              "photoUrl": "string | null",
              "packageName": "string",
              "remainingSessions": "number | null",
              "expireDate": "datetime | null",
              "lastCheckIn": "datetime"
            }
          },
          "errors": [
            "404 — ບໍ່ພົບລະຫັດບັດ",
            "400 — Anti-Passback: ລໍຖ້າ N ນາທີ",
            "400 — ແພັກເກັດໝົດອາຍຸ",
            "400 — ຈຳນວນຄັ້ງໝົດ"
          ]
        },
        {
          "id": "members-create",
          "method": "POST",
          "path": "/members",
          "description": "ລົງທະບຽນສະມາຊິກໃໝ່",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "body": {
            "code": "string (required) — ລະຫັດບັດ / Barcode",
            "fullName": "string (required)",
            "phone": "string (required)",
            "photoUrl": "string (optional)",
            "packageId": "number (optional)",
            "expireDate": "string ISO date (optional) — YYYY-MM-DD",
            "remainingSessions": "number (optional, default: 0)"
          },
          "response": "Member object with package relation"
        },
        {
          "id": "members-findAll",
          "method": "GET",
          "path": "/members",
          "description": "ດຶງລາຍຊື່ສະມາຊິກທັງໝົດ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "body": null,
          "response": "array of Member objects with package"
        },
        {
          "id": "members-findOne",
          "method": "GET",
          "path": "/members/:id",
          "description": "ດຶງຂໍ້ມູນສະມາຊິກຕາມ ID",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "params": { "id": "number" },
          "body": null,
          "response": "Member object with package"
        },
        {
          "id": "members-update",
          "method": "PATCH",
          "path": "/members/:id",
          "description": "ແກ້ໄຂຂໍ້ມູນສະມາຊິກ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "params": { "id": "number" },
          "body": {
            "code": "string (optional)",
            "fullName": "string (optional)",
            "phone": "string (optional)",
            "photoUrl": "string (optional)",
            "packageId": "number (optional)",
            "expireDate": "string ISO date (optional)",
            "remainingSessions": "number (optional)"
          },
          "response": "Updated Member object with package"
        },
        {
          "id": "members-remove",
          "method": "DELETE",
          "path": "/members/:id",
          "description": "ລົບສະມາຊິກ (ADMIN Only)",
          "auth": true,
          "roles": ["ADMIN"],
          "params": { "id": "number" },
          "body": null,
          "response": "Deleted Member object"
        }
      ]
    },
    {
      "module": "Packages",
      "basePath": "/packages",
      "endpoints": [
        {
          "id": "packages-create",
          "method": "POST",
          "path": "/packages",
          "description": "ສ້າງແພັກເກັດໃໝ່",
          "auth": true,
          "roles": ["ADMIN"],
          "body": {
            "name": "string (required) — ຊື່ແພັກເກັດ",
            "priceLak": "number (required) — ລາຄາ (ກີບ)",
            "durationDays": "number (optional) — ຈຳນວນວັນ",
            "sessions": "number (optional) — ຈຳນວນຄັ້ງ (ຄູປອງ)"
          },
          "response": "Package object"
        },
        {
          "id": "packages-findAll",
          "method": "GET",
          "path": "/packages",
          "description": "ດຶງລາຍການແພັກເກັດທັງໝົດ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "body": null,
          "response": "array of Package objects"
        },
        {
          "id": "packages-findOne",
          "method": "GET",
          "path": "/packages/:id",
          "description": "ດຶງຂໍ້ມູນແພັກເກັດຕາມ ID",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "params": { "id": "number" },
          "body": null,
          "response": "Package object"
        },
        {
          "id": "packages-update",
          "method": "PATCH",
          "path": "/packages/:id",
          "description": "ແກ້ໄຂຂໍ້ມູນແພັກເກັດ",
          "auth": true,
          "roles": ["ADMIN"],
          "params": { "id": "number" },
          "body": {
            "name": "string (optional)",
            "priceLak": "number (optional)",
            "durationDays": "number (optional)",
            "sessions": "number (optional)"
          },
          "response": "Updated Package object"
        },
        {
          "id": "packages-remove",
          "method": "DELETE",
          "path": "/packages/:id",
          "description": "ລົບແພັກເກັດ",
          "auth": true,
          "roles": ["ADMIN"],
          "params": { "id": "number" },
          "body": null,
          "response": "Deleted Package object"
        }
      ]
    },
    {
      "module": "Payments",
      "basePath": "/payments",
      "notes": "ເມື່ອສ້າງ Payment ພ້ອມ memberId + packageId ລະບົບຈະອັບເດດ expireDate ຫຼື remainingSessions ອັດໂນມັດ",
      "endpoints": [
        {
          "id": "payments-create",
          "method": "POST",
          "path": "/payments",
          "description": "ບັນທຶກການຊຳລະເງິນ + ອັບເດດ Package ສະມາຊິກອັດໂນມັດ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "note": "staffId ດຶງອັດໂນມັດຈາກ JWT Token",
          "body": {
            "memberId": "number (optional) — ID ສະມາຊິກ",
            "packageId": "number (optional) — ID ແພັກເກັດທີ່ຊື້",
            "description": "string (required) — ລາຍລະອຽດ",
            "amountLak": "number (required) — ຍອດລວມ (ກີບ)",
            "paidCurrency": "LAK | THB | USD (optional, default: LAK)",
            "exchangeRate": "number (optional, default: 1)",
            "amountPaid": "number (required) — ຈຳນວນເງິນທີ່ຈ່າຍຕາມ Currency",
            "changeLak": "number (optional, default: 0) — ເງິນທອນ (ກີບ)",
            "paymentMethod": "CASH | BCEL_ONE_QR (optional, default: CASH)"
          },
          "response": "Payment object with staff and member info"
        },
        {
          "id": "payments-findAll",
          "method": "GET",
          "path": "/payments",
          "description": "ດຶງປະຫວັດການຊຳລະເງິນທັງໝົດ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "body": null,
          "response": "array of Payment objects (desc by createdAt)"
        },
        {
          "id": "payments-findOne",
          "method": "GET",
          "path": "/payments/:id",
          "description": "ດຶງໃບບິນຕາມ ID",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "params": { "id": "number" },
          "body": null,
          "response": "Payment object with staff and member info"
        }
      ]
    },
    {
      "module": "Expenses",
      "basePath": "/expenses",
      "endpoints": [
        {
          "id": "expenses-create",
          "method": "POST",
          "path": "/expenses",
          "description": "ບັນທຶກລາຍຈ່າຍໃໝ່",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "note": "staffId ດຶງອັດໂນມັດຈາກ JWT Token",
          "body": {
            "title": "string (required) — ຫົວຂໍ້ລາຍຈ່າຍ",
            "category": "SUPPLIES | UTILITIES | MAINTENANCE | MISCELLANEOUS (optional, default: SUPPLIES)",
            "amountLak": "number (required) — ຍອດລວມ (ກີບ)",
            "paidCurrency": "LAK | THB | USD (optional, default: LAK)",
            "exchangeRate": "number (optional, default: 1)",
            "amountPaid": "number (required) — ຈຳນວນເງິນທີ່ຈ່າຍຕາມ Currency",
            "receiptUrl": "string (optional) — ລິ້ງຮູບໃບເສັດ"
          },
          "response": "Expense object with staff info"
        },
        {
          "id": "expenses-findAll",
          "method": "GET",
          "path": "/expenses",
          "description": "ດຶງລາຍການລາຍຈ່າຍທັງໝົດ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "body": null,
          "response": "array of Expense objects (desc by createdAt)"
        },
        {
          "id": "expenses-findOne",
          "method": "GET",
          "path": "/expenses/:id",
          "description": "ດຶງລາຍຈ່າຍຕາມ ID",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "params": { "id": "number" },
          "body": null,
          "response": "Expense object with staff info"
        },
        {
          "id": "expenses-update",
          "method": "PATCH",
          "path": "/expenses/:id",
          "description": "ແກ້ໄຂລາຍຈ່າຍ",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "params": { "id": "number" },
          "body": {
            "title": "string (optional)",
            "category": "SUPPLIES | UTILITIES | MAINTENANCE | MISCELLANEOUS (optional)",
            "amountLak": "number (optional)",
            "paidCurrency": "LAK | THB | USD (optional)",
            "exchangeRate": "number (optional)",
            "amountPaid": "number (optional)",
            "receiptUrl": "string (optional)"
          },
          "response": "Updated Expense object with staff info"
        },
        {
          "id": "expenses-remove",
          "method": "DELETE",
          "path": "/expenses/:id",
          "description": "ລົບລາຍຈ່າຍ (ADMIN Only)",
          "auth": true,
          "roles": ["ADMIN"],
          "params": { "id": "number" },
          "body": null,
          "response": "Deleted Expense object"
        }
      ]
    },
    {
      "module": "Reports",
      "basePath": "/reports",
      "endpoints": [
        {
          "id": "reports-financial",
          "method": "GET",
          "path": "/reports/financial",
          "description": "ລາຍງານການເງິນ (ກຳໄລ-ຂາດທຶນ) — ADMIN Only",
          "auth": true,
          "roles": ["ADMIN"],
          "query": {
            "startDate": "string ISO date (optional) — YYYY-MM-DD (default: ວັນທີ 1 ຂອງເດືອນ)",
            "endDate": "string ISO date (optional) — YYYY-MM-DD (default: ມື້ນີ້)"
          },
          "response": {
            "period": { "startDate": "datetime", "endDate": "datetime" },
            "summary": {
              "totalIncome": "number",
              "totalExpense": "number",
              "netProfit": "number",
              "status": "PROFIT | LOSS",
              "transactionCounts": { "payments": "number", "expenses": "number" }
            },
            "incomeByMethod": "array grouped by paymentMethod",
            "expenseByCategory": "array grouped by category"
          }
        },
        {
          "id": "reports-checkIns",
          "method": "GET",
          "path": "/reports/check-ins",
          "description": "ລາຍງານສະຖິຕິສະມາຊິກ & Check-in",
          "auth": true,
          "roles": ["ADMIN", "STAFF"],
          "query": {
            "startDate": "string ISO date (optional) — YYYY-MM-DD",
            "endDate": "string ISO date (optional) — YYYY-MM-DD"
          },
          "response": {
            "period": { "startDate": "datetime", "endDate": "datetime" },
            "stats": {
              "totalCheckInsInPeriod": "number",
              "totalMembers": "number",
              "activeMembers": "number",
              "expiringSoonCount": "number"
            },
            "expiringSoonMembers": "array of members expiring within 7 days"
          }
        }
      ]
    }
  ],
  "enums": {
    "Role": ["ADMIN", "STAFF"],
    "Currency": ["LAK", "THB", "USD"],
    "PaymentMethod": ["CASH", "BCEL_ONE_QR"],
    "ExpenseCategory": ["SUPPLIES", "UTILITIES", "MAINTENANCE", "MISCELLANEOUS"]
  },
  "summary": {
    "totalModules": 7,
    "totalEndpoints": 22,
    "publicEndpoints": 1,
    "protectedEndpoints": 21,
    "adminOnlyEndpoints": 10,
    "adminAndStaffEndpoints": 11
  }
}
